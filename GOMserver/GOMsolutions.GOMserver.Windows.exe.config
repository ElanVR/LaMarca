<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="unity" type="Microsoft.Practices.Unity.Configuration.UnityConfigurationSection, Microsoft.Practices.Unity.Configuration" />
    <section name="securityCryptographyConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Security.Cryptography.Configuration.CryptographySettings, Microsoft.Practices.EnterpriseLibrary.Security.Cryptography" />
    <section name="hibernate-configuration" type="NHibernate.Cfg.ConfigurationSectionHandler, NHibernate" />
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="GOMsolutions.GOMserver.Windows.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="GOMsolutions.GOMserver.Windows.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <unity>
    <containers>
      <container>
        <types>
          <type type="GOMsolutions.Security.BE.IMembrecia, GOMsolutions.Security.BE" mapTo="GOMsolutions.Security.Service.MembreciaService, GOMsolutions.Core" />
          <type type="GOMsolutions.Core.IRepositorio`1, GOMsolutions.Core" mapTo="GOMsolutions.Core.RepositorioNHibernate`1, GOMsolutions.Core" />
          <type type="GOMsolutions.Core.ITransaccion, GOMsolutions.Core" mapTo="GOMsolutions.Core.TransaccionNHibernate, GOMsolutions.Core" />
        </types>
      </container>
    </containers>
  </unity>
  <securityCryptographyConfiguration>
    <hashProviders>
      <add protectedKeyFilename="C:\GOMserver\GOMsolutions.key" protectedKeyProtectionScope="LocalMachine" algorithmType="System.Security.Cryptography.HMACSHA256, mscorlib, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" saltEnabled="false" type="Microsoft.Practices.EnterpriseLibrary.Security.Cryptography.KeyedHashAlgorithmProvider, Microsoft.Practices.EnterpriseLibrary.Security.Cryptography" name="Hash" />
    </hashProviders>
    <symmetricCryptoProviders>
      <add algorithmType="System.Security.Cryptography.RijndaelManaged, mscorlib, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" protectedKeyFilename="C:\GOMserver\GOMsolutions.key" protectedKeyProtectionScope="LocalMachine" type="Microsoft.Practices.EnterpriseLibrary.Security.Cryptography.SymmetricAlgorithmProvider, Microsoft.Practices.EnterpriseLibrary.Security.Cryptography" name="Provider" />
    </symmetricCryptoProviders>
  </securityCryptographyConfiguration>
  <hibernate-configuration xmlns="urn:nhibernate-configuration-2.2">
    <session-factory name="Produccion">
      <property name="connection.provider">NHibernate.Connection.DriverConnectionProvider</property>
      <property name="connection.driver_class">NHibernate.Driver.SqlClientDriver</property>
      <property name="dialect">NHibernate.Dialect.MsSql2012Dialect</property>
      <property name="adonet.batch_size">60</property>
      <property name="query.substitutions">true 1, false 0, yes 1, no 0</property>
      <property name="command_timeout">60</property>
      <property name="show_sql">false</property>
      <mapping assembly="GOMsolutions.Security.BE" />
      <mapping assembly="GOMsolutions.GOMserver.General.BE" />
      <mapping assembly="GOMsolutions.GOMserver.Accounting.BE" />
      <mapping assembly="GOMsolutions.GOMserver.Inventory.BE" />
      <mapping assembly="GOMsolutions.GOMserver.Charging.BE" />
      <mapping assembly="GOMsolutions.GOMserver.Invoicing.BE" />
      <mapping assembly="GOMsolutions.GOMserver.Payable.BE" />
      <mapping assembly="GOMsolutions.GOMserver.Helpdesk.BE" />
      <mapping assembly="GOMsolutions.GOMserver.Bank.BE" />
    </session-factory>
  </hibernate-configuration>
  <appSettings>
    <add key="UrlSecurityUtilities" value="https://servicios.nubegom.com/seguridad" />
    <!--Cola de impresion-->
    <add key="PrintsPath" value="C:\GOMserver\ParametrosImpresion.xml" />
    <add key="ExportarPath" value="C:\GOMserver\TransactionLog\XMLData.xml" />
    <add key="Tiempo" value="5" />
    <!--<add key="ReportesPath" value="C:\GOMserver\TransactionReports\" />-->
  </appSettings>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager enabled="true" defaultProvider="ClientRoleProvider">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>
  <applicationSettings>
    <GOMsolutions.GOMserver.Windows.Properties.Settings>
      <setting name="GOMsolutions_GOMserver_Windows_gt_com_ecofactura_nit_DatCont"
        serializeAs="String">
        <value>https://gface.ecofactura.com.gt:8443/gface/servlet/adatcont</value>
      </setting>
      <setting name="GOMsolutions_GOMserver_Windows_gt_com_ecofactura_anulacion_R_Anu_Fac"
        serializeAs="String">
        <value>https://gface.ecofactura.com.gt:8443/gface/servlet/ar_anu_fac</value>
      </setting>
      <setting name="GOMsolutions_GOMserver_Windows_gt_com_ecofactura_R_Car_Fac"
        serializeAs="String">
        <value>https://gface.ecofactura.com.gt:8443/gface/servlet/ar_car_fac</value>
      </setting>
      <setting name="GOMsolutions_GOMserver_Windows_gt_com_efactura_FactWSFront"
        serializeAs="String">
        <value>https://gface.efactura.com.gt/mx.com.fact.wsfront/FactWSFront.asmx</value>
      </setting>
      <setting name="GOMsolutions_GOMserver_Windows_gt_com_infilefactura_ingface"
        serializeAs="String">
        <value>https://www.ingface.net:443/listener/ingface</value>
      </setting>
      <setting name="GOMsolutions_GOMserver_Windows_gt_com_infilefactura_nit_ingfaceWsServices"
        serializeAs="String">
        <value>https://www.ingface.net:443/ServiciosIngface/ingfaceWsServices</value>
      </setting>
      <setting name="GOMsolutions_GOMserver_Windows_gt_com_infilefactura_anulacion_AnulacionDte"
        serializeAs="String">
        <value>https://www.ingface.net:443/RAIng/AnulacionDte</value>
      </setting>
    </GOMsolutions.GOMserver.Windows.Properties.Settings>
  </applicationSettings>
  <system.serviceModel>
    <bindings />
    <client />
  </system.serviceModel>
  <userSettings>
    <GOMsolutions.GOMserver.Windows.Properties.Settings>
      <setting name="Company" serializeAs="String">
        <value />
      </setting>
      <setting name="Tema" serializeAs="String">
        <value>DevExpress Style</value>
      </setting>
    </GOMsolutions.GOMserver.Windows.Properties.Settings>
  </userSettings>
</configuration>